{
  "name": "stellar-agent-search-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Landing page for stellar-agent-search. Not published — the npm package ships only dist/ (see the root package.json `files` field).",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check:release-surface": "node scripts/assert-release-surface.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "npm run build && npm run check:release-surface && wrangler deploy"
  },
  "dependencies": {
    "shiki": "^4.0.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "simple-icons": "^16.27.1",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.44.0"
  }
}
