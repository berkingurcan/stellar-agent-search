# Cloudflare Workers Static Assets reads this file, serves it to nobody, and applies
# it to matching responses. adapter-static copies static/ into build/, which is the
# `directory` wrangler.toml points at — so it ships automatically with `npm run deploy`.
#
# The main CSP is NOT here. It is generated by SvelteKit (`kit.csp` in svelte.config.js)
# because it has to carry per-build hashes for two inline scripts. Only the one directive
# that cannot travel in a <meta http-equiv> tag is set here.

/*
  # Browsers ignore frame-ancestors in a meta tag, so SvelteKit's CSP cannot carry it.
  # A landing page is never framed; this blocks clickjacking outright.
  Content-Security-Policy: frame-ancestors 'none'
  # Stops a mistyped Content-Type from letting an asset be executed as script.
  X-Content-Type-Options: nosniff
  # Outbound links (GitHub, npm, arXiv, stellar8004.com) see the origin, never the path.
  Referrer-Policy: strict-origin-when-cross-origin
  # The page asks for none of these; deny them so an injected script cannot either.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()

# Vite fingerprints everything under this path, so the filename changes whenever the
# bytes do. Cache it for a year — the default for static assets is revalidate-on-every-
# request, which spends a round trip to be told "unchanged" on every repeat visit.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must never be pinned: it names the fingerprinted bundles above, so a stale copy
# points at files that no longer exist. Revalidate every time, but allow a cheap 304.
/
  Cache-Control: public, max-age=0, must-revalidate
/404.html
  Cache-Control: public, max-age=0, must-revalidate
