{
  "name": "stellar-agent-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server + CLI to discover, rank, and inspect on-chain Stellar (stellar-8004) agents, with on-chain-verified reputation.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stellar-agent-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.berkingurcan/stellar-agent-mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkingurcan/stellar-agent-mcp.git"
  },
  "homepage": "https://github.com/berkingurcan/stellar-agent-mcp#readme",
  "bugs": {
    "url": "https://github.com/berkingurcan/stellar-agent-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stellar",
    "soroban",
    "erc-8004",
    "stellar-8004",
    "x402",
    "agent-discovery",
    "reputation",
    "usdc"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "validate:release": "node scripts/release/validate-release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run validate:release",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@stellar/stellar-sdk": "^15",
    "@trionlabs/stellar8004": "0.0.11",
    "@x402/core": "~2.20.0",
    "@x402/fetch": "~2.20.0",
    "@x402/stellar": "~2.20.0",
    "dotenv": "^16.6.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^22",
    "agents": "0.20.1",
    "ajv": "8.20.0",
    "tsup": "^8",
    "typescript": "^5",
    "vitest": "^3",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "axios": "1.18.1",
    "@hono/node-server": "^2.0.5"
  }
}
