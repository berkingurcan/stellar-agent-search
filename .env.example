# Network: mainnet (default, SOW requires it) | testnet
# The default explorer indexes mainnet only, so testnet never uses it. With no
# data source set, testnet reads its newest 50 agents straight from the testnet
# Identity contract (registry mode); EXPLORER_BASE_URL (a testnet indexer),
# REGISTRY_AGENT_IDS or REGISTRY_SCAN_LIMIT below choose another source.
STELLAR_NETWORK=mainnet

# Optional Soroban RPC override. Defaults to @trionlabs/stellar8004 config
# (mainnet: https://mainnet.sorobanrpc.com).
STELLAR_RPC_URL=https://mainnet.sorobanrpc.com

# Explorer HTTP API base. Default: https://stellar8004.com
EXPLORER_BASE_URL=https://stellar8004.com

# Registry mode: read these agents straight from the Identity contract, with no
# explorer (comma-separated ids, at most 50). Comment out EXPLORER_BASE_URL above
# to use it; the server refuses two data sources at once.
# REGISTRY_AGENT_IDS=12,40

# Registry mode over the newest agents: how many (1-50) of the most recently
# registered agents lists and searches read. Testnet's default (50); on mainnet,
# setting it replaces the explorer. Not combinable with the two above.
# REGISTRY_SCAN_LIMIT=50

# Validation Registry validators whose Provider Standard records earn badges in
# get_provider_manifest (comma-separated G… or C… addresses, at most 20). Empty:
# the registry is not read and no badge is shown.
# TRUSTED_VALIDATORS=G...

# On-chain verification (declared-vs-verified). Set false to skip Soroban reads.
VERIFY_ONCHAIN=true

# Ranking constants / 3-axis weights (optional overrides).
# Feedback values are 0..100 integers (valueDecimals=0) → score max is 100.
RANK_SCORE_MAX=100
RANK_W_QUALITY=0.5
RANK_W_VOLUME=0.2
RANK_W_BREADTH=0.3

# NOTE: This server is READ-ONLY and holds NO private keys.
# STELLAR_PRIVATE_KEY is intentionally ignored if present (defense in depth).
