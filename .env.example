# Network: mainnet (default, SOW requires it) | testnet (dev)
STELLAR_NETWORK=mainnet

# Optional Soroban RPC override. Defaults to @trionlabs/stellar8004 config
# (mainnet: https://mainnet.sorobanrpc.com).
STELLAR_RPC_URL=https://mainnet.sorobanrpc.com

# Explorer HTTP API base. Default: https://stellar8004.com
EXPLORER_BASE_URL=https://stellar8004.com

# On-chain verification (declared-vs-verified). Set false to skip Soroban reads.
VERIFY_ONCHAIN=true

# Ranking constants / 3-axis weights (optional overrides).
# Feedback values are 0..100 integers (valueDecimals=0) → score max is 100.
RANK_SCORE_MAX=100
RANK_W_QUALITY=0.5
RANK_W_VOLUME=0.2
RANK_W_BREADTH=0.3

# NOTE: This server is READ-ONLY and holds NO private keys.
# STELLAR_PRIVATE_KEY is intentionally ignored if present (defense in depth).
