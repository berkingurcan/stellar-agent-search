# examples/x402-demo.ts — environment template.
# Copy to examples/.env and fill in. NEVER commit the real .env.
#
# SECURITY: STELLAR_PRIVATE_KEY and X402_API_KEY live ONLY in this demo process.
# They are NEVER passed to the MCP server (spawned with a secret-free env allowlist).

# ---- REQUIRED for a real run (demo script only; NEVER given to the MCP server) ----
STELLAR_PRIVATE_KEY=S...                  # Ed25519 S-format secret of the PAYING agent. Fund + add USDC trustline first.
# X402_API_KEY=                           # NOT NEEDED. This client signs the payment locally and submits it as
#                                         # a header; the resource server settles with its own facilitator. Kept
#                                         # in the secret allowlist only so a stray value can never leak to the
#                                         # MCP subprocess. The live scrapper challenge names no facilitator.

# ---- NETWORK (default mainnet per SOW; the dry-run gate is DRY_RUN=1 on mainnet) ----
STELLAR_NETWORK=mainnet                   # mainnet | testnet  (maps to CAIP-2 stellar:pubnet / stellar:testnet)
# STELLAR_RPC_URL=https://mainnet.sorobanrpc.com   # optional Soroban RPC override
# EXPLORER_BASE_URL=https://stellar8004.com        # optional on mainnet; forwarded to the MCP server (non-secret).
#                                                  # REQUIRED if STELLAR_NETWORK=testnet — the default explorer
#                                                  # indexes mainnet only and the server refuses the mismatch.

# ---- MCP wiring ----
MCP_SERVER_ENTRY=../dist/index.js         # path (relative to examples/) to the built read-only MCP server
# Evidence identity/routing/payment facts are deliberately NOT env overrides. The script pins agent 10,
# its reviewed owner, https://scrapper.stellar8004.com/task, and its expected G... payTo in source. A change
# requires review; discovery or a modified runtime environment cannot silently redirect a signed payment.

# ---- Scrapper invocation (the x402 task endpoint request) ----
# SCRAPE_METHOD=POST                      # HTTP method used to call the scrapper endpoint
# SCRAPE_TARGET=https://example.com       # URL to scrape (wrapped as {"url": ...} JSON body)
# SCRAPE_BODY={"url":"https://example.com"}  # full JSON body override (takes precedence over SCRAPE_TARGET)

# ---- Preflight thresholds / behavior ----
MIN_USDC=0.10                             # abort (real run) if payer USDC balance below this
MIN_XLM=3                                 # reserves + self-paid give_feedback fee headroom
MAX_PRICE_USDC=0.10                       # refuse to sign if the 402 challenge asks for more than this.
                                          # The challenge is written by the resource server, so its price is
                                          # not trusted. Must be finite, non-negative, <= 7 decimals.
                                          # Scrapper currently asks $0.0001.
DRY_RUN=0                                 # 1 = no spend. Balance/key/RPC checks are advisory, but failed MCP
                                          # discovery, x402=false, or identity/endpoint mismatch is still fatal.
